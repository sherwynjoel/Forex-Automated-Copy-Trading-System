# Postgres (dev default password is fine locally; change on a VPS)
POSTGRES_PASSWORD=copytrader
POSTGRES_DSN=postgresql://copytrader:copytrader@postgres:5432/copytrader

# cTrader Open API app credentials — register at https://openapi.ctrader.com (see README)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:8000/api/oauth/callback
CTRADER_AUTH_URL=https://openapi.ctrader.com/apps/auth
CTRADER_TOKEN_URL=https://openapi.ctrader.com/apps/token
CTRADER_DEMO_HOST=demo.ctraderapi.com
CTRADER_LIVE_HOST=live.ctraderapi.com
CTRADER_PORT=5035

# Secrets — generate FERNET_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
SESSION_SECRET=

# Optional: claim a migrated legacy ("Default") org on first boot.
# Leave both empty on a fresh install — register through the UI instead.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Internal wiring
COPIER_CONTROL_URL=http://copier:8080
SHARDS=1

# Email alerts (optional). Sent via Resend (resend.com) on margin calls,
# kill-switch fires, token refresh failures, degraded slaves, and rejected
# copies. Leave empty to disable alerting entirely.
# INSTANCE-WIDE: one key and one recipient for the whole deployment, so
# every organization's alerting events go to this same operator inbox.
# Per-org recipients are future work.
RESEND_API_KEY=
# The address alerts go TO (your inbox):
ALERT_EMAIL_TO=
# The FROM address. resend.dev works without domain verification for
# sending to your own verified email; use your own domain once verified.
ALERT_EMAIL_FROM=Copy Desk <onboarding@resend.dev>

# Telegram notifications (optional). Used for account cutoff reminders --
# two days before an admin-set cutoff date, the reminder goes to the
# dashboard (banner + events feed) AND this Telegram chat; deliberately
# not email. INSTANCE-WIDE like the email alerter: one bot, one chat.
# Create a bot with @BotFather to get the token; message the bot once,
# then GET https://api.telegram.org/bot<token>/getUpdates to read your
# chat id. Leave either empty and no Telegram message is ever attempted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Security switches
# ---------------------------------------------------------------------------
# Database password. REQUIRED: compose refuses to start without it (there is
# deliberately no default -- a well-known fallback is a credential).
POSTGRES_PASSWORD=

# Self-service signup at /register. Leave false in production: accounts are
# created by the operator or through an org invite.
REGISTRATION_ENABLED=false

# Set true when a reverse proxy (Caddy/nginx) terminates TLS in front of the
# api. Without it every request looks like it came from the proxy and per-IP
# rate limiting collapses into one shared bucket.
TRUST_PROXY=false

# Which peers may carry that forwarded address, beyond the two the api
# trusts on its own: loopback, and (when it runs in Docker) the container's
# default gateway -- where connections from a proxy on the host arrive from.
# Name any other proxy here by address or CIDR, comma-separated. Only the
# TradingView webhook route is this strict; leave empty for the shipped
# Caddy-on-host layout.
TRUSTED_PROXY_IPS=

# Public origin of the site, e.g. https://mirrorfleet.com. Used to reject
# WebSocket handshakes from other origins. Empty allows localhost (dev).
PUBLIC_ORIGIN=

# Fat-finger ceiling on MANUAL orders, in lots. Copied trades are not
# affected -- they mirror whatever the master actually did.
MAX_MANUAL_ORDER_LOTS=10

# Cookies get the Secure flag (and the app sends HSTS) unless this is
# false. Only set it false for plain-HTTP local development.
COOKIE_SECURE=true

# Clear BOTH of these once the first admin account exists: they put a
# plaintext admin password in the environment and in `docker inspect`.
# The password must meet the same 10-character minimum as any other.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
