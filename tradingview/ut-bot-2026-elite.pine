// Original Logic Credit: QuantNomad
// Trade management added for the owner: entry-candle stop-loss, target
// input, step-trailing profit lock, and MirrorFleet webhook wiring
// (entries send buy/sell with stop_loss + take_profit; every exit --
// stop, target, or reversal -- sends close).

//@version=6
indicator("UT Bot Alerts [2026 Elite Edition]", shorttitle="UT Bot 2026", overlay=true, max_labels_count=500, max_lines_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 1. CONFIGURATION & INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// Group: MirrorFleet + Trade Management
grp_tm     = "🎯 TRADE MANAGEMENT (MirrorFleet)"
secret     = input.string("tvw_PASTE_SECRET_HERE", "MirrorFleet secret", group=grp_tm)
lots       = input.float(0.01, "Lots", step=0.01, minval=0.01, group=grp_tm)
target_pts = input.float(5.0, "Target (points)", minval=0.1, step=0.1, group=grp_tm, tooltip="Take-profit distance from entry, in price points.")
trail_start= input.float(1.0, "Start trailing after (points)", minval=0.1, step=0.1, group=grp_tm, tooltip="Once the trade is this many points in profit, the stop starts locking profit.")
trail_step = input.float(0.5, "Trail step (points)", minval=0.1, step=0.1, group=grp_tm, tooltip="Each additional step of new profit ratchets the stop up by one step.")

// Group: Buy Settings
grp_buy    = "🟢 BUY SETTINGS (Long)"
buy_key    = input.float(2.0, "Buy Key Value (Sensitivity)", minval=0.1, group=grp_buy, tooltip="Multiplier for the Buy Signal calculation.")
buy_atr    = input.int(300, "Buy ATR Period", minval=1, group=grp_buy, tooltip="Lookback period for Buy signals. Higher = Slower/Smoother.")
buy_col    = input.color(color.new(#00E676, 0), "Buy Line Color", group=grp_buy)
buy_shape  = input.string("Label Up", "Buy Signal Shape", options=["Label Up", "Triangle Up", "Arrow Up", "Diamond"], group=grp_buy)

// Group: Sell Settings
grp_sell   = "🔴 SELL SETTINGS (Short)"
sell_key   = input.float(2.0, "Sell Key Value (Sensitivity)", minval=0.1, group=grp_sell, tooltip="Multiplier for the Sell Signal calculation.")
sell_atr   = input.int(1, "Sell ATR Period", minval=1, group=grp_sell, tooltip="Lookback period for Sell signals. Lower = Faster/Responsive.")
sell_col   = input.color(color.new(#FF5252, 0), "Sell Line Color", group=grp_sell)
sell_shape = input.string("Label Down", "Sell Signal Shape", options=["Label Down", "Triangle Down", "Arrow Down", "Diamond"], group=grp_sell)

// Group: General Settings
grp_gen    = "⚙️ GENERAL & VISUALS"
use_ha     = input.bool(false, "Use Heikin Ashi Candles", group=grp_gen, tooltip="Calculates signals based on Heikin Ashi Close rather than standard Close.")
show_dash  = input.bool(true, "Show Info Dashboard", group=grp_gen)
line_width = input.int(2, "Trailing Stop Line Width", minval=1, maxval=5, group=grp_gen)
bar_paint  = input.bool(true, "Color Candles", group=grp_gen)

// ══════════════════════════════════════════════════════════════════════════════
// 2. SMART CALCULATIONS (Dual Engine)
// ══════════════════════════════════════════════════════════════════════════════

ticker_id = use_ha ? ticker.heikinashi(syminfo.tickerid) : syminfo.tickerid
src = request.security(ticker_id, timeframe.period, close, lookahead = barmerge.lookahead_off)

// Engine 1: Buy Logic (Ceiling / Resistance)
xATR_Buy  = ta.atr(buy_atr)
nLoss_Buy = buy_key * xATR_Buy

// Engine 2: Sell Logic (Floor / Support)
xATR_Sell  = ta.atr(sell_atr)
nLoss_Sell = sell_key * xATR_Sell

// ══════════════════════════════════════════════════════════════════════════════
// 3. STATE MACHINE
// ══════════════════════════════════════════════════════════════════════════════

var float xATRTrailingStop = 0.0
var int pos = 0

float prev_stop = nz(xATRTrailingStop[1])
int prev_pos    = nz(pos[1])

if prev_pos == 1 // Currently Long
    float new_floor = src - nLoss_Sell
    if src < prev_stop // Stop Hit! Switch to Short
        xATRTrailingStop := src + nLoss_Buy
        pos := -1
    else
        xATRTrailingStop := math.max(prev_stop, new_floor)
        pos := 1
else // Currently Short (or start)
    float new_ceiling = src + nLoss_Buy
    if src > prev_stop // Stop Hit! Switch to Long
        xATRTrailingStop := src - nLoss_Sell
        pos := 1
    else
        xATRTrailingStop := math.min(prev_stop, new_ceiling)
        pos := -1

// ══════════════════════════════════════════════════════════════════════════════
// 4. SIGNALS
// ══════════════════════════════════════════════════════════════════════════════

bool buy_signal  = pos == 1 and prev_pos == -1
bool sell_signal = pos == -1 and prev_pos == 1

// ══════════════════════════════════════════════════════════════════════════════
// 5. TRADE MANAGEMENT (entry-candle stop, target, step-trailing profit)
// ══════════════════════════════════════════════════════════════════════════════

var int inTrade    = 0     // 1 long, -1 short, 0 flat
var float entryPx  = na
var float stopLvl  = na    // starts at the ENTRY CANDLE's low (long) / high (short), then trails
var float targetLvl= na    // entry +/- target_pts
var float maxFav   = na    // best profit seen, in points

entryMsg(action) =>
    '{"secret": "' + secret + '", "action": "' + action + '", "symbol": "' + syminfo.ticker +
     '", "lots": ' + str.tostring(lots) +
     ', "stop_loss": ' + str.tostring(stopLvl, format.mintick) +
     ', "take_profit": ' + str.tostring(targetLvl, format.mintick) +
     ', "id": "' + str.tostring(time) + '"}'

closeMsg() =>
    '{"secret": "' + secret + '", "action": "close", "symbol": "' + syminfo.ticker +
     '", "id": "' + str.tostring(time) + '"}'

// Exits are judged against the state BEFORE this bar's entries.
bool stopHitLong    = inTrade == 1  and not na(stopLvl)   and low  <= stopLvl
bool stopHitShort   = inTrade == -1 and not na(stopLvl)   and high >= stopLvl
bool targetHitLong  = inTrade == 1  and not na(targetLvl) and high >= targetLvl
bool targetHitShort = inTrade == -1 and not na(targetLvl) and low  <= targetLvl
bool reverseLong    = inTrade == 1  and sell_signal
bool reverseShort   = inTrade == -1 and buy_signal

bool exitLong  = stopHitLong  or targetHitLong  or reverseLong
bool exitShort = stopHitShort or targetHitShort or reverseShort

// Exit first: on a reversal bar the flatten goes on the wire before (or at
// worst alongside) the opposite entry.
if exitLong or exitShort
    alert(closeMsg(), alert.freq_once_per_bar_close)
    inTrade := 0
    entryPx := na
    stopLvl := na
    targetLvl := na
    maxFav := na

// Step-trailing profit lock: nothing moves until trail_start points of
// profit; then the stop jumps to entry + (trail_start - trail_step) and
// ratchets one trail_step for every new trail_step of best profit. It only
// ever tightens.
if inTrade == 1
    maxFav := math.max(nz(maxFav), high - entryPx)
    if maxFav >= trail_start
        stopLvl := math.max(stopLvl, entryPx + trail_start - trail_step + math.floor((maxFav - trail_start) / trail_step) * trail_step)

if inTrade == -1
    maxFav := math.max(nz(maxFav), entryPx - low)
    if maxFav >= trail_start
        stopLvl := math.min(stopLvl, entryPx - (trail_start - trail_step + math.floor((maxFav - trail_start) / trail_step) * trail_step))

// Entries (a reversal bar exits above, then enters here).
if buy_signal
    inTrade := 1
    entryPx := close
    stopLvl := low            // the entry candle's LOW is the long stop
    targetLvl := close + target_pts
    maxFav := high - entryPx
    alert(entryMsg("buy"), alert.freq_once_per_bar_close)

if sell_signal
    inTrade := -1
    entryPx := close
    stopLvl := high           // the entry candle's HIGH is the short stop
    targetLvl := close - target_pts
    maxFav := entryPx - low
    alert(entryMsg("sell"), alert.freq_once_per_bar_close)

// ══════════════════════════════════════════════════════════════════════════════
// 6. PLOTTING
// ══════════════════════════════════════════════════════════════════════════════

color current_color = pos == 1 ? buy_col : sell_col
color text_col_dyn  = color.white

plot(xATRTrailingStop, "Trailing Stop", color=current_color, linewidth=line_width, style=plot.style_line)
barcolor(bar_paint ? current_color : na)

get_shape(style_str) =>
    switch style_str
        "Label Up"      => shape.labelup
        "Label Down"    => shape.labeldown
        "Triangle Up"   => shape.triangleup
        "Triangle Down" => shape.triangledown
        "Arrow Up"      => shape.arrowup
        "Arrow Down"    => shape.arrowdown
        "Diamond"       => shape.diamond
        => shape.circle

plotshape(buy_signal, title="Buy Signal", style=get_shape(buy_shape), location=location.belowbar, color=buy_col, text="BUY", textcolor=text_col_dyn, size=size.tiny)
plotshape(sell_signal, title="Sell Signal", style=get_shape(sell_shape), location=location.abovebar, color=sell_col, text="SELL", textcolor=text_col_dyn, size=size.tiny)
plotshape(exitLong or exitShort, title="Trade Exit", style=shape.xcross, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)

// Trade-management levels while a trade is on
plot(inTrade != 0 ? entryPx : na, "Entry Price", color.new(color.blue, 0), 2, plot.style_linebr)
plot(inTrade != 0 ? stopLvl : na, "Trade Stop (trailing)", color.new(color.orange, 0), 2, plot.style_linebr)
plot(inTrade != 0 ? targetLvl : na, "Trade Target", color.new(#00E676, 30), 1, plot.style_linebr)

// ══════════════════════════════════════════════════════════════════════════════
// 7. DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 50), border_width=1)

if show_dash and barstate.islast
    table.cell(hud, 0, 0, "UT BOT 2026", text_color=current_color, text_size=size.small, bgcolor=color.new(color.black, 0))
    table.merge_cells(hud, 0, 0, 1, 0)

    table.cell(hud, 0, 1, "Status:", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 1, pos == 1 ? "LONG 🟢" : "SHORT 🔴", text_color=current_color, text_size=size.small, text_halign=text.align_right)

    table.cell(hud, 0, 2, "Stop Price:", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 2, str.tostring(xATRTrailingStop, format.mintick), text_color=color.gray, text_size=size.small, text_halign=text.align_right)

    float active_atr = pos == 1 ? xATR_Sell : xATR_Buy
    table.cell(hud, 0, 3, "Active ATR:", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 3, str.tostring(active_atr, format.mintick), text_color=color.gray, text_size=size.small, text_halign=text.align_right)

    table.cell(hud, 0, 4, "Trade:", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 4, inTrade == 1 ? "LONG @" + str.tostring(entryPx, format.mintick) : inTrade == -1 ? "SHORT @" + str.tostring(entryPx, format.mintick) : "FLAT", text_color=inTrade != 0 ? current_color : color.gray, text_size=size.small, text_halign=text.align_right)

// ══════════════════════════════════════════════════════════════════════════════
// 8. ALERTS
// ══════════════════════════════════════════════════════════════════════════════

// Legacy notification-only conditions (cannot trade; kept for humans)
alertcondition(buy_signal, "UT Bot Buy", "UT Bot Buy Signal Detected")
alertcondition(sell_signal, "UT Bot Sell", "UT Bot Sell Signal Detected")
// The MirrorFleet trading alerts are the alert() calls in section 5 --
// create ONE TradingView alert with condition "Any alert() function call"
// and the MirrorFleet webhook URL. Entries carry stop_loss + take_profit;
// stop hits, target hits and reversals all send close.
