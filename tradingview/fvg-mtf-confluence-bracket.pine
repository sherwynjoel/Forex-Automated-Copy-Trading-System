//@version=6
indicator("FVG MTF Confluence Bracket", overlay=true)

// ─── HOW TO SET THIS UP ───────────────────────────────────────────────────────
// Put the chart on your ENTRY timeframe (e.g. 1 min). The entry candle is
// always this chart's own candle -- that is a Pine limitation, not a choice:
// a script cannot watch a lower timeframe bar-by-bar from a higher chart.
// The confirmation timeframes below should be HIGHER than the chart (3, 5,
// 15...) and are pulled by the script itself via request.security, so you
// never have to switch charts to see them.
//
// A = i-2, B = i-1, C = i. Same FVG detection everywhere:
//     bull  low > high[2]      bear  high < low[2]
// A colored candle on the entry chart means a fresh signal confirmed here --
// lime for bullish, red for bearish. Confirmation timeframes use the same
// rule on their own LAST CLOSED bar, so they never repaint.
//
// ─── TWO ORDER MODES ──────────────────────────────────────────────────────────
//  Market (fire on touch)      The script watches price itself. The instant
//                              it touches the signal candle's high (buy) or
//                              low (sell) a market order is sent. One alert
//                              per trade.
//  Stop order (rest at broker) The moment the signal candle confirms, a buy
//                              stop at its high and a sell stop at its low
//                              are placed at the broker, which holds them
//                              and fills whichever price reaches first. When
//                              one fills (price touches its level) the script
//                              sends a cancel that pulls the other leg. A
//                              fresh signal candle cancels the old pair before
//                              placing the new one.
//
// ─── FILTERS AND SIGNAL RULES ─────────────────────────────────────────────────
// Candle filters measure the signal candle itself (body and full length, in
// price units) and are OFF by default. Signal rules decide which colored
// candles may arm: the first of a run of same-colour candles, the first that
// passes the filters, or every one; whether a leg whose level price has
// already passed is dropped rather than chased; and whether a new signal
// replaces a bracket that is still waiting or is ignored until it resolves.
// ═══════════════════════════════════════════════════════════════════════════════

g1 = "① Confirmation timeframes (all enabled ones must agree in direction)"
g2 = "② Order, stop / target   (price units — dollars on gold)"
g3 = "③ Candle filters   (all OFF by default)"
g4 = "④ Signal rules"
g5 = "⑤ Webhook payload"

useTf1 = input.bool(true, "Use", group = g1, inline = "tf1")
tf1    = input.timeframe("3",  "", group = g1, inline = "tf1")
useTf2 = input.bool(true, "Use", group = g1, inline = "tf2")
tf2    = input.timeframe("5",  "", group = g1, inline = "tf2")
useTf3 = input.bool(true, "Use", group = g1, inline = "tf3")
tf3    = input.timeframe("15", "", group = g1, inline = "tf3")

orderMode = input.string("Market (fire on touch)", "Order type",
     options=["Market (fire on touch)", "Stop order (rest at broker)"], group = g2,
     tooltip="Market: the script waits for price to touch the level, then sends a market order. Stop order: a buy stop at the high and a sell stop at the low are placed at the broker the moment the signal candle confirms; the broker fills whichever price reaches, and the script cancels the other.")
slMode  = input.string("Candle high/low", "Stop loss from", options=["Candle high/low", "Fixed distance"], group = g2,
     tooltip="Candle high/low = the entry candle's opposite extreme (buy stops at its low, sell stops at its high). Fixed distance = a set distance from the entry level.")
slValue = input.float(2.0, "Stop loss distance (fixed mode)", minval=0.01, step=0.1, group = g2,
     tooltip="Price units. 2.0 on gold means entry 4300.00 -> stop 4298.00 (buy) or 4302.00 (sell).")
tpValue = input.float(2.0, "Take profit distance", minval=0.0, step=0.1, group = g2,
     tooltip="Price units beyond entry. 2.0 on gold means entry 4300.00 -> target 4302.00 (buy) or 4298.00 (sell). Set 0 to send no target and let MirrorFleet's Risk Engine set it after the fill instead.")

useBody  = input.bool(false, "Filter by body (open → close)", group = g3,
     tooltip="OFF. Turn on once you are happy with the signal count. Measures the signal candle's body in price units.")
bodyMin  = input.float(0.0, "Min body", minval=0.0, step=0.1, group = g3)
bodyMax  = input.float(1.5, "Max body", minval=0.0, step=0.1, group = g3)
useRange = input.bool(false, "Filter by full length (high → low)", group = g3,
     tooltip="OFF. Turn on once you are happy with the signal count. Measures the signal candle's full high-to-low length in price units.")
rangeMin = input.float(0.0, "Min length", minval=0.0, step=0.1, group = g3)
rangeMax = input.float(3.0, "Max length", minval=0.0, step=0.1, group = g3)

runMode = input.string("First candle of run only", "Consecutive same-colour candles",
     options=["First candle of run only", "First eligible candle in run", "Off — every candle"], group = g4,
     tooltip="What to do when several same-colour candles print in a row. Off is there so you can see the raw signal rate with nothing suppressed.")
skipIfPassed = input.bool(true, "Skip if price has already passed the level", group = g4,
     tooltip="Keep this ON. Per leg: if the bar already closed above the signal candle's high the buy side is dropped, below its low the sell side is dropped. OFF chases -- a market order fires on the next touch, and a stop order resting behind the market is refused by the broker.")
onOpposite = input.string("Drop and arm new", "New signal while one is already armed",
     options=["Drop and arm new", "Ignore until resolved"], group = g4,
     tooltip="Drop and arm new: a fresh signal candle replaces the bracket still waiting (in stop mode its resting orders are cancelled first). Ignore until resolved: nothing changes until the waiting bracket fires or is dropped.")

wSecret = input.string("", "MirrorFleet secret", group = g5, tooltip="Paste the secret from your Automation page here.")
wSym    = input.string("", "Broker symbol override", group = g5)
wLots   = input.float(0.01, "Lots sent to broker", minval=0.01, step=0.01, group = g5)

brokerSym = wSym == "" ? syminfo.ticker : wSym
stopMode  = orderMode == "Stop order (rest at broker)"
fixedSl   = slMode == "Fixed distance"

// Stop-loss always ships with the order. take_profit ships only when the
// target input is above 0 -- at 0 it is left out so MirrorFleet's Risk
// Engine can set it post-fill from the real price.
f_levels(float sl, float tp) =>
    string tpField = tpValue > 0 ? ',"take_profit":' + str.tostring(tp, format.mintick) : ""
    ',"stop_loss":' + str.tostring(sl, format.mintick) + tpField

f_head(string action) =>
    '{"secret":"' + wSecret + '","id":"' + str.tostring(time) + '","action":"' + action + '","symbol":"' + brokerSym + '"'

f_market(string action, float sl, float tp) =>
    f_head(action) + ',"lots":' + str.tostring(wLots) + f_levels(sl, tp) + '}'

f_stop(string action, float px, float sl, float tp) =>
    f_head(action) + ',"lots":' + str.tostring(wLots) + ',"order_type":"stop","price":' + str.tostring(px, format.mintick) + f_levels(sl, tp) + '}'

f_cancel() =>
    f_head("cancel") + '}'

// The signal as of a timeframe's LAST CLOSED bar: the [1]-shifted form of the
// same gap rule, with lookahead_on so the value lands the moment that bar
// closes and never changes afterwards. Called unconditionally for every slot
// (request.security must not run conditionally); disabled slots are simply
// ignored in the confluence check below.
f_fvg(simple string tf) =>
    request.security(syminfo.tickerid, tf, [low[1] > high[3], high[1] < low[3]], lookahead = barmerge.lookahead_on)

[bull1, bear1] = f_fvg(tf1)
[bull2, bear2] = f_fvg(tf2)
[bull3, bear3] = f_fvg(tf3)

bullConfluence = (not useTf1 or bull1) and (not useTf2 or bull2) and (not useTf3 or bull3)
bearConfluence = (not useTf1 or bear1) and (not useTf2 or bear2) and (not useTf3 or bear3)

// The entry chart's own signal, evaluated directly on this chart's candles.
isBullFVG = low  > high[2]
isBearFVG = high < low[2]
sigDir    = isBullFVG ? 1 : isBearFVG ? -1 : 0

conf = barstate.isconfirmed

// ─── Candle B on the entry chart -- the one actually traded ───────────────────
bHi   = high[1]
bLo   = low[1]
bOpen = open[1]
bCls  = close[1]

bodyPrice  = math.abs(bCls - bOpen)
rangePrice = bHi - bLo

bodyOK = not useBody  or (bodyPrice  >= bodyMin  and bodyPrice  <= bodyMax)
rngOK  = not useRange or (rangePrice >= rangeMin and rangePrice <= rangeMax)

// ─── Run tracking: explicit state, no history-indexed booleans ────────────────
var int prevPaint  = 0         // colour of the previous bar's signal: 1 / -1 / 0
var int runId      = 0
var int armedRunId = -1

isFirstOfRun = sigDir != 0 and sigDir != prevPaint

if conf and isFirstOfRun
    runId += 1

elig = switch runMode
    "First candle of run only"     => isFirstOfRun
    "First eligible candle in run" => sigDir != 0 and armedRunId != runId
    => sigDir != 0

// An entry is only allowed when the entry candle's own signal points the
// same way every enabled confirmation timeframe agrees on, and the candle
// passes the filters and the run rule.
allowBull = isBullFVG and bullConfluence and bodyOK and rngOK and elig
allowBear = isBearFVG and bearConfluence and bodyOK and rngOK and elig

barcolor(isBullFVG ? color.new(color.lime, 70) : isBearFVG ? color.new(color.red, 70) : na, offset=-1)
plotshape(conf and allowBull, title="Confluence buy",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(conf and allowBear, title="Confluence sell", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

// ─── Bracket state ────────────────────────────────────────────────────────────
// Each leg is tracked on its own: a leg whose level price already passed may
// be skipped while the other still arms. In stop mode a live leg is an order
// resting at the broker; in market mode it is a level the script watches.
var float aHi = na
var float aLo = na
var bool  buyLive  = false
var bool  sellLive = false
var int   armBar   = -1

armed = buyLive or sellLive
busy  = armed and onOpposite == "Ignore until resolved"

buySl(float hi, float lo)  => fixedSl ? hi - slValue : lo
sellSl(float hi, float lo) => fixedSl ? lo + slValue : hi

if conf and (allowBull or allowBear) and not busy
    if stopMode and armed
        alert(f_cancel(), alert.freq_all)          // drop the pair still resting
    aHi := bHi
    aLo := bLo
    armBar := bar_index
    armedRunId := runId
    // Skip a leg the bar already traded through: chasing it means a market
    // order at a worse price, or a stop the broker refuses as invalid.
    buyLive  := not skipIfPassed or close < aHi
    sellLive := not skipIfPassed or close > aLo
    if stopMode
        if buyLive
            alert(f_stop("buy", aHi, buySl(aHi, aLo), aHi + tpValue), alert.freq_all)
        if sellLive
            alert(f_stop("sell", aLo, sellSl(aHi, aLo), aLo - tpValue), alert.freq_all)

// Remember this bar's colour AFTER the decision, so isFirstOfRun compares
// against the previous bar and not against itself.
if conf
    prevPaint := sigDir

// Touch detection runs only on bars AFTER the arming bar: on the arming bar
// itself the level was set from the previous candle and the current one may
// already have traded through it before the pair even existed.
if (buyLive or sellLive) and bar_index > armBar
    if buyLive and high >= aHi
        if stopMode
            alert(f_cancel(), alert.freq_all)     // buy stop filled; pull the sell leg
        else
            alert(f_market("buy", buySl(aHi, aLo), aHi + tpValue), alert.freq_once_per_bar)
        buyLive  := false
        sellLive := false
    else if sellLive and low <= aLo
        if stopMode
            alert(f_cancel(), alert.freq_all)     // sell stop filled; pull the buy leg
        else
            alert(f_market("sell", sellSl(aHi, aLo), aLo - tpValue), alert.freq_once_per_bar)
        buyLive  := false
        sellLive := false

if buyLive
    line.new(bar_index, aHi, bar_index + 1, aHi, color = color.new(color.lime, 20), style = line.style_dashed)
if sellLive
    line.new(bar_index, aLo, bar_index + 1, aLo, color = color.new(color.orange, 20), style = line.style_dashed)
