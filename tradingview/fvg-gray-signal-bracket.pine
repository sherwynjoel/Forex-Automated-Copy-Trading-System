//@version=6
indicator("FVG Gray Signal Bracket", overlay=true)

// A = i-2, B = i-1, C = i
// Detect an FVG (gap between A and C), either direction -- this is what
// paints candle B: lime for bullish, red for bearish. Both are "signal
// candles" -- every one of them gets a straddle, regardless of direction.
isBullFVG = low  > high[2]
isBearFVG = high < low[2]

wSecret = input.string("", "MirrorFleet secret", tooltip="Paste the secret from your Automation page here.")
wSym    = input.string("", "Broker symbol override")
wLots   = input.float(0.01, "Lots sent to broker", minval=0.01, step=0.01)

brokerSym = wSym == "" ? syminfo.ticker : wSym

// Stop-loss still ships with the order -- it's the signal candle's own
// high/low, always correctly signed and normally has real width, so it
// was not the source of the "invalid stops" rejections. No take_profit
// is sent: that was a small, fixed distance computed too early, and MT5
// rejects the WHOLE order if either level is invalid. MirrorFleet's Risk
// Engine now sets the real take-profit itself right after the fill
// confirms, off the real fill price -- set a target-only distance (leave
// stop blank) for XAUUSD on the Automation page's Symbol Risk Rules.
f_order(string action, float sl) =>
    '{"secret":"' + wSecret + '","id":"' + str.tostring(time) + '","action":"' + action + '","symbol":"' + brokerSym +
     '","lots":' + str.tostring(wLots) + ',"stop_loss":' + str.tostring(sl, format.mintick) + '}'

conf = barstate.isconfirmed

// Candle B -- the signal candle itself. The straddle's levels come from
// its own high and low, not from any other candle.
bHi = high[1]
bLo = low[1]

barcolor(isBullFVG ? color.new(color.lime, 70) : isBearFVG ? color.new(color.red, 70) : na, offset=-1)

// Bracket armed on the signal candle: buy triggers at its high, sell at its
// low. A fresh signal candle always replaces whatever was still armed --
// nothing has been sent to the broker yet, so there is nothing to undo.
var float aHi = na
var float aLo = na
var bool  armed = false

if conf and (isBullFVG or isBearFVG)
    aHi := bHi
    aLo := bLo
    armed := true

if armed and high >= aHi
    alert(f_order("buy", aLo), alert.freq_once_per_bar)
    armed := false
else if armed and low <= aLo
    alert(f_order("sell", aHi), alert.freq_once_per_bar)
    armed := false

if armed
    line.new(bar_index, aHi, bar_index + 1, aHi, color = color.new(color.lime, 20), style = line.style_dashed)
    line.new(bar_index, aLo, bar_index + 1, aLo, color = color.new(color.orange, 20), style = line.style_dashed)
